# Site media — photos, video posters, logo files.
#
# Served publicly (that is the point), but never executed. This is a folder
# people drop files into, so the same rule as uploads/ applies: a file that
# arrives as an "image" must not be able to leave as PHP.

<FilesMatch "\.(php|phtml|php[0-9]|phps|phar|pl|py|cgi|asp|aspx|jsp|sh|bash)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .cgi .pl .py
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar

<IfModule mod_php.c>
    php_flag engine off
</IfModule>

Options -Indexes -ExecCGI
