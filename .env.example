# 3AM — Environment configuration
# ===============================
# Copy to .env and fill in. NEVER commit .env.
#
#   cp .env.example .env && chmod 600 .env
#
# On the server .env lives in /var/www/3am/shared/ and is symlinked into each
# release, so a deploy never overwrites it and secrets survive a rollback.

# ── Application ──────────────────────────────────────────────
APP_NAME="3AM Media, Technology and Ventures Inc."
APP_ENV=production                  # local | staging | production
APP_DEBUG=false                     # MUST be false in production
APP_URL=https://3ammediatech.com
APP_TIMEZONE=Asia/Manila

# 32+ random bytes, base64. Generate with:
#   php -r "echo base64_encode(random_bytes(32));"
APP_KEY=

# ── Database ─────────────────────────────────────────────────
# MariaDB 11.6 on the application server. The runtime user below has DML only
# and no grants on any other schema — a compromise of this site cannot read a
# single row belonging to /armonyx or /trebl.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=threeam
DB_USERNAME=3am_app
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Migration credentials are intentionally NOT here. bin/migrate.php prompts, or
# reads .env.migrate (0600, root-owned). The application must never hold DDL
# rights at runtime.

# ── Sessions ─────────────────────────────────────────────────
# ★ COLLISION HAZARD ★
# The legacy apps share this domain. If they use the default PHPSESSID at path
# '/' and this site does too, the cookies clobber each other and users get
# logged out of /armonyx unpredictably. Distinct name AND distinct store,
# always. Confirm the legacy value in Phase 0 audit §5 before changing this.
SESSION_NAME=TAM_SESS
SESSION_DRIVER=database
SESSION_LIFETIME=120                # idle timeout, minutes
SESSION_ABSOLUTE_LIFETIME=720       # hard cap, minutes
SESSION_SECURE=true
SESSION_SAMESITE=Lax

# ── Legacy application protection ────────────────────────────
# Scanned for real directories, each of which becomes a reserved path.
# See config/reserved.php and app/Middleware/ReservedPath.php.
LEGACY_DOCROOT=/var/www/html

# ── Media storage ────────────────────────────────────────────
# Originals and derivatives on private S3, served through CloudFront on a CDN
# subdomain. Deliberately NOT the apex: fronting the apex with CloudFront would
# put the legacy apps behind a cache they were never tested against.
MEDIA_DISK=s3                       # s3 | local (local for dev only)
AWS_REGION=ap-southeast-1
AWS_BUCKET=3am-media
AWS_BUCKET_PREFIX=uploads
MEDIA_CDN_URL=https://cdn.3ammediatech.com

# Leave key/secret EMPTY in production — the EC2 instance role supplies
# credentials. Static keys in a file are the thing we are avoiding.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

MEDIA_MAX_IMAGE_MB=10
MEDIA_MAX_VIDEO_MB=50
MEDIA_DRIVER=imagick                # imagick | gd — verify in Phase 0 audit §5

# ── Mail (Amazon SES) ────────────────────────────────────────
MAIL_HOST=email-smtp.ap-southeast-1.amazonaws.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@3ammediatech.com
MAIL_FROM_NAME="3AM Digital Media"
MAIL_INQUIRY_TO=3ammediatech@gmail.com

# ── Security ─────────────────────────────────────────────────
ADMIN_PATH=admin                    # consider a non-obvious value in production
ADMIN_IP_ALLOWLIST=                 # comma-separated; empty disables the check
ADMIN_REQUIRE_2FA=true              # TOTP mandatory for all admin accounts

RATE_LIMIT_LOGIN=5                  # attempts per window, per identifier AND per IP
RATE_LIMIT_LOGIN_WINDOW=900         # seconds
RATE_LIMIT_CONTACT=3                # submissions per hour per IP

FORCE_HTTPS=true
HSTS_MAX_AGE=31536000

# ── Logging ──────────────────────────────────────────────────
LOG_CHANNEL=daily
LOG_LEVEL=warning                   # debug only in local
LOG_MAX_FILES=14
